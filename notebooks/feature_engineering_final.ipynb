    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "OUTPUT_DIR = '../data/final'\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
    "\n",
    "input_path = '../data/final/events_final.csv'\n",
    "if not os.path.exists(input_path):\n",
    "    raise FileNotFoundError(f'No se encontró {input_path}')\n",
    "\n",
    "df = pd.read_csv(input_path, parse_dates=['event_time'])\n",
    "df['event_time'] = df['event_time'].dt.tz_localize(None)\n",
    "df['hora'] = df['event_time'].dt.hour\n",
    "\n",
    "print(f'Input usado: {input_path}')\n",
    "print(df.shape)\n",
    "df.head(3)"
   ]
